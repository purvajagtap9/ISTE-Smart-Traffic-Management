# ===============================
# Flask Core Configuration
# ===============================
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace_with_a_long_random_secret

# ===============================
# Database
# SQLite file will be created automatically
# ===============================
DATABASE_URL=sqlite:///iste.db

# ===============================
# Google OAuth (Authlib)
# ===============================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# ===============================
# Admin auto-role list
# ===============================
# Add admin emails as a comma-separated list.
# Example: ADMIN_EMAILS=admin@gmail.com,admin2@gmail.com
ADMIN_EMAILS=admin@gmail.com,admin2@gmail.com

# ===============================
# Twilio OTP Settings
# ===============================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Note (OTP demo):
# If Twilio keys are not set, the OTP will not be SMSed.
# Instead, the OTP will be printed in the terminal (demo fallback).

# ===============================
# Camera and Detection Settings
# Add 3-4 Android IP Webcam URLs
# ===============================
CAMERA_1_URL=http://192.168.1.10:8080/video
CAMERA_2_URL=http://192.168.1.11:8080/video
CAMERA_3_URL=http://192.168.1.12:8080/video
CAMERA_4_URL=http://192.168.1.13:8080/video

YOLO_MODEL_PATH=models/yolov8n.pt
DETECTION_CONFIDENCE=0.5

# ===============================
# Optional Cloud Simulation
# ===============================
CLOUD_SYNC_ENABLED=true
CLOUD_SYNC_INTERVAL_SECONDS=60

# ===============================
# App Flags
# ===============================
ENABLE_AUTONOMOUS_MODE=true
ENABLE_EMERGENCY_PREEMPTION=true
ENABLE_AUTOMATED_ENFORCEMENT=true


MAIL_USERNAME=projectadmin7@gmail.com
MAIL_PASSWORD=abcd efgh ijkl mnop
MAIL_DEFAULT_SENDER=projectadmin7@gmail.com
